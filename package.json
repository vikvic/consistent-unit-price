{
  "name": "consistent-unit-price",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run build:chrome && npm run build:firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-release-assets.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.1",
    "typescript": "^5.7.3"
  }
}
